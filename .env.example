# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Experience ---------------------------------------------------------
# X in the years-of-experience formula (scope.md §6.4). A direct number of
# years, not a start date — date-derivation would silently overcount across
# a career break. Shared by all 4 resumes — no separate AI-experience value.
EXPERIENCE_YEARS=  # TODO: e.g. 3.5

# --- LLM -----------------------------------------------------------------
# LLM_MODE picks the branch — there is no cross-provider fallback, exactly
# one provider is used per run:
#   dev  -> always Ollama, using OLLAMA_MODEL directly. Free, no key needed.
#   prod -> exactly one of the providers below, named by LLM_PROVIDER. Real
#           hosted API, real cost. That provider's API key must be set.
LLM_MODE=dev
LLM_PROVIDER=deepseek  # only used when LLM_MODE=prod — one of the 7 below
BATCH_SIZE=1
MAX_RETRIES_PER_PROVIDER=3

# Only used when LLM_MODE=dev
OLLAMA_MODEL=  # TODO: e.g. qwen2.5:3b — any local 3-4B class model
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only the one named by LLM_PROVIDER needs to be set, and only when
# LLM_MODE=prod.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Optional per-provider model override. Leave blank to use the built-in
# default (DEFAULT_MODELS in scoring/providers.py) — only the one matching
# LLM_PROVIDER matters. Picking a model with no entry in scoring/providers.py's
# PRICING table is fine (budget tracking just reports $0 spend for it, with a
# warning in the logs) — add a PRICING entry with real numbers from the
# provider's pricing page if you want accurate cost tracking for it.
DEEPSEEK_MODEL=  # default: deepseek-chat
KIMI_MODEL=  # default: moonshot-v1-8k
GEMINI_MODEL=  # default: gemini-2.5-flash
MISTRAL_MODEL=  # default: mistral-large-latest
OPENAI_MODEL=  # default: gpt-5-mini
ANTHROPIC_MODEL=  # default: claude-sonnet-5 — e.g. claude-haiku-4-5-20251001 (cheaper/faster) or claude-opus-5 (stronger)
GROK_MODEL=  # default: grok-4

# --- Budget ----------------------------------------------------------------
DAILY_TOKEN_SPEND_CEILING_USD=3.0

# --- Scoring -----------------------------------------------------------
SCORE_THRESHOLD_STRONG=70
SCORE_THRESHOLD_CONSIDER=60

# --- Email ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mabotta12@gmail.com
SMTP_APP_PASSWORD=  # TODO: Gmail App Password (requires 2FA on the account)
DIGEST_RECIPIENT=mabotta12@gmail.com
DIGEST_TIME_PDT=08:00
TIMEZONE=America/Los_Angeles

# --- Paths -----------------------------------------------------------------
# Defaults are fine for local dev; override only if you need different locations.
# DATA_DIR=data
# LOG_DIR=logs
# OUTPUT_DIR=output
# RESUME_MANIFEST=config/resumes/manifest.json
# DB_PATH=data/coldstart.sqlite3

# --- Polling ---------------------------------------------------------------
# MANIFEST_URL=https://storage.stapply.ai/jobhive/v1/manifest.json
# POLL_INTERVAL_MINUTES=30
