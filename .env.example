# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Experience ---------------------------------------------------------
# Anchors X in the years-of-experience formula (scope.md §6.4). Shared by
# all 4 resumes — there is no separate AI-experience date.
EXPERIENCE_START_DATE=  # TODO: e.g. 2022-06-01

# --- LLM -----------------------------------------------------------------
# dev = local Ollama, free, no key needed. prod = real hosted API, real cost.
LLM_MODE=dev
LLM_PROVIDER=deepseek
PROVIDER_FALLBACK_ORDER=deepseek,kimi
BATCH_SIZE=1
MAX_RETRIES_PER_PROVIDER=3

# Only used when LLM_MODE=dev
OLLAMA_MODEL=  # TODO: e.g. qwen2.5:3b — any local 3-4B class model
OLLAMA_BASE_URL=http://localhost:11434/v1

# Only required for providers actually in PROVIDER_FALLBACK_ORDER, and only
# when LLM_MODE=prod.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# --- Budget ----------------------------------------------------------------
DAILY_TOKEN_SPEND_CEILING_USD=3.0

# --- Scoring -----------------------------------------------------------
SCORE_THRESHOLD_STRONG=70
SCORE_THRESHOLD_CONSIDER=60

# --- Email ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mabotta12@gmail.com
SMTP_APP_PASSWORD=  # TODO: Gmail App Password (requires 2FA on the account)
DIGEST_RECIPIENT=mabotta12@gmail.com
DIGEST_TIME_PDT=08:00
TIMEZONE=America/Los_Angeles

# --- Paths -----------------------------------------------------------------
# Defaults are fine for local dev; override only if you need different locations.
# DATA_DIR=data
# LOG_DIR=logs
# OUTPUT_DIR=output
# RESUME_MANIFEST=config/resumes/manifest.json
# DB_PATH=data/coldstart.sqlite3

# --- Polling ---------------------------------------------------------------
# MANIFEST_URL=https://storage.stapply.ai/jobhive/v1/manifest.json
# POLL_INTERVAL_MINUTES=30
