# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Experience ---------------------------------------------------------
# X in the years-of-experience formula (scope.md §6.4). A direct number of
# years, not a start date — date-derivation would silently overcount across
# a career break. Shared by all 4 resumes — no separate AI-experience value.
EXPERIENCE_YEARS=  # TODO: e.g. 3.5

# --- LLM -----------------------------------------------------------------
# LLM_MODE picks the branch — there is no cross-provider fallback, exactly
# one provider is used per run:
#   dev  -> always Ollama, using OLLAMA_MODEL directly. Free, no key needed.
#   prod -> exactly one of the providers below, named by LLM_PROVIDER. Real
#           hosted API, real cost. That provider's API key must be set.
LLM_MODE=dev
LLM_PROVIDER=deepseek  # only used when LLM_MODE=prod — one of the 7 below
BATCH_SIZE=1
MAX_RETRIES_PER_PROVIDER=3

# Only used when LLM_MODE=dev
OLLAMA_MODEL=  # TODO: e.g. qwen2.5:3b — any local 3-4B class model
OLLAMA_BASE_URL=http://localhost:11434/v1

# Per-request timeout for any LLM call. Local Ollama models are slow, hence
# the generous default.
LLM_REQUEST_TIMEOUT_SECONDS=120

# Only the one named by LLM_PROVIDER needs to be set, and only when
# LLM_MODE=prod.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Optional per-provider model override. Leave blank to use the built-in
# default (DEFAULT_MODELS in scoring/providers.py) — only the one matching
# LLM_PROVIDER matters. Picking a model with no entry in scoring/providers.py's
# PRICING table is fine (budget tracking just reports $0 spend for it, with a
# warning in the logs) — add a PRICING entry with real numbers from the
# provider's pricing page if you want accurate cost tracking for it.
DEEPSEEK_MODEL=  # default: deepseek-chat
KIMI_MODEL=  # default: moonshot-v1-8k
GEMINI_MODEL=  # default: gemini-2.5-flash
MISTRAL_MODEL=  # default: mistral-large-latest
OPENAI_MODEL=  # default: gpt-5-mini
ANTHROPIC_MODEL=  # default: claude-sonnet-5 — e.g. claude-haiku-4-5-20251001 (cheaper/faster) or claude-opus-5 (stronger)
GROK_MODEL=  # default: grok-4

# --- Budget ----------------------------------------------------------------
DAILY_TOKEN_SPEND_CEILING_USD=3.0

# --- Freshness -------------------------------------------------------------
# Skip postings older than this before they ever reach an LLM. A job posted
# months ago is usually filled, and scoring it spends money on something you
# can't apply to. Measured on real data, a 15-day window removes ~95% of LLM
# calls. Postings with no date at all are always kept.
#
# Note this is measured against today, not against the snapshot: upstream
# regenerates irregularly, so if it goes quiet for longer than this window
# everything looks stale and nothing gets scored. That case logs a WARNING
# rather than passing silently.
MAX_POSTING_AGE_DAYS=15

# --- Scoring -----------------------------------------------------------
# Binary bar: score >= this is shown as "strong"; anything else is rejected.
SCORE_THRESHOLD_STRONG=80

# --- Email ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mabotta12@gmail.com
SMTP_APP_PASSWORD=  # TODO: Gmail App Password (requires 2FA on the account)
DIGEST_RECIPIENT=mabotta12@gmail.com
DIGEST_TIME_PDT=08:00
TIMEZONE=America/Los_Angeles

# --- Logging ---------------------------------------------------------------
# DEBUG gives per-job detail; INFO is stage summaries. The daemon runs for
# weeks against a 10 MB x 5 rotating log, so DEBUG is worth turning off again
# once you're done investigating something.
LOG_LEVEL=INFO

# --- Paths -----------------------------------------------------------------
# Defaults are fine for local dev; override only if you need different locations.
# DATA_DIR=data
# LOG_DIR=logs
# OUTPUT_DIR=output
# RESUME_MANIFEST=config/resumes/manifest.json
# DB_PATH=data/coldstart.sqlite3

# --- Daemon ----------------------------------------------------------------
# `scripts/run_daemon.py` reads all of these. The one-shot scripts don't —
# they run once and exit, so their cadence is whatever invokes them.
# MANIFEST_URL=https://storage.stapply.ai/jobhive/v1/manifest.json

# How often to check upstream for a new snapshot. The check itself is a
# conditional GET that usually comes back "304 Not Modified" with no body, so
# a short interval costs essentially nothing.
POLL_INTERVAL_MINUTES=30

# Ceiling on a single run_poll. A full 36-slice pass re-verifies ~1.4 GB of
# cached parquet and can peak around 10 GB RSS on the largest slice, so give
# it real room — this is a runaway guard, not a target.
POLL_TIMEOUT_MINUTES=240
DIGEST_TIMEOUT_MINUTES=10

# Poll unconditionally this often even when upstream reports no change. An
# ETag can go stale on a CDN, and a run that died mid-slice leaves work behind
# that no manifest change will ever re-trigger.
FORCE_POLL_HOURS=6

# --- Dashboard -------------------------------------------------------------
# Served by the daemon at http://DASHBOARD_HOST:DASHBOARD_PORT.
DASHBOARD_ENABLED=true

# Loopback on purpose: the page has no authentication and shows your full
# match list. Only change this if something else is handling access control.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# --- Liveness Check ----------------------------------------------------------
# apply_url doesn't tell you a posting is gone — Workday's job pages are a
# client-rendered SPA that returns 200 either way. This checks each ATS's own
# API instead (workday/greenhouse/lever only), once before an LLM call is
# spent, and again on a schedule for postings already scored but not yet
# acted on. One switch turns off both: a real HTTP call per checkable job
# against a third-party site should be easy to disable.
LIVENESS_CHECK_ENABLED=true

# How often the periodic sweep re-checks already-scored, unactioned postings.
# Runs on its own daemon thread, independent of POLL_INTERVAL_MINUTES — it
# hits third-party ATS endpoints directly and must not scale with poll
# frequency or queue behind a multi-hour poll.
LIVENESS_SWEEP_INTERVAL_HOURS=24
LIVENESS_SWEEP_TIMEOUT_MINUTES=15
